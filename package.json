{
  "name": "@charleypeng/dsh-codex-bridge",
  "version": "1.0.0",
  "type": "module",
  "description": "Reads local Codex credentials, enables the Codex model route, and shows Codex allowance in a settings page.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "status-cache.js",
    "model-registry.js",
    "model-store.js",
    "live-adapter.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charleypeng/dsh-codex-bridge.git"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
